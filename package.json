{
  "name": "dsh-gui-auth-url",
  "version": "0.2.0",
  "displayName": "GUI Auth URL",
  "description": "把当前运行的 DeepSeek Harness Web GUI 的合法带 token 地址暴露成一个工具，供 agent 和浏览器自动化直接打开。",
  "license": "MIT",
  "author": "NingYuanLee",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/auth-url.js",
    "prepublishOnly": "npm test && npm run check"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NingYuanLee/dsh-gui-auth-url.git"
  },
  "homepage": "https://github.com/NingYuanLee/dsh-gui-auth-url#readme",
  "bugs": {
    "url": "https://github.com/NingYuanLee/dsh-gui-auth-url/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "gui",
    "browser-automation",
    "authenticated-url"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "alpha"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  }
}
