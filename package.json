{
  "name": "dsh-gui-auth-url",
  "version": "0.2.1",
  "displayName": "GUI Auth URL",
  "description": "Expose the running DeepSeek Harness Web GUI's authenticated URL as an agent tool, so browser automation can open the GUI instead of failing with 401.",
  "license": "MIT",
  "author": "NingYuanLee",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "README*.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/auth-url.js",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check && npm run check:pack"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NingYuanLee/dsh-gui-auth-url.git"
  },
  "homepage": "https://github.com/NingYuanLee/dsh-gui-auth-url#readme",
  "bugs": {
    "url": "https://github.com/NingYuanLee/dsh-gui-auth-url/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "gui",
    "web-gui",
    "browser-automation",
    "authenticated-url",
    "agent-tool"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0"
  }
}
